FASTWIKI_ENV=development
FASTWIKI_PORT=5022
FASTWIKI_SECRET=change-me
FASTWIKI_DB=data/fastwiki.sqlite
FASTWIKI_UPLOAD_DIR=data/uploads
FASTWIKI_ATTACHMENT_BACKEND=local
FASTWIKI_MAX_UPLOAD_MB=20
FASTWIKI_PUBLIC_URL=https://wiki.mymedicalgateway.co.uk
FASTOFFICE_URL=http://localhost:5020
FASTOFFICE_SSO_SECRET=
FASTSME_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://wiki.mymedicalgateway.co.uk/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=mymedicalgateway.com
FASTWIKI_ORG_ID=mymedicalgateway.com
FASTWIKI_ORG_NAME=My Medical Gateway
# Cloudflare R2 / S3-compatible storage
R2_ENDPOINT=
R2_BUCKET=fastwiki
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Optional FastDrive binary upload adapter
FASTDRIVE_UPLOAD_URL=
FASTDRIVE_SERVICE_TOKEN=
